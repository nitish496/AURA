<?xml version="1.0" encoding="utf-8"?>
<!-- AURA Compact widget: 64dp panel, 10dp padding, 44dp cover (concentric with the 22dp panel). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_black">
        <ImageView
            android:id="@+id/widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">
            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Album cover"
                android:scaleType="fitCenter" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Nothing playing"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Open AURA to choose music"
                    android:textSize="13sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="Previous song"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_previous" />
            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Play music"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play" />
            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="48dp"
                android:contentDescription="Next song"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next" />
            <ImageView
                android:id="@+id/widget_settings"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:contentDescription="Customize widget"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
